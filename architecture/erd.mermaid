  category { string catid PK }
  product { string productid PK
    string catid FK }
  item { string itemid PK
    string productid FK }
  item_details { string itemid PK
    string locale PK
    decimal listprice
    decimal unitcost }
  signon_user { string username PK
    string password "plain text" }
  customer { string user_id PK
    string account_id FK
    string profile_id FK }
  account { string account_id PK
    string status }
  credit_card { string card_id PK
    string card_number
    string expiry_date }
  purchase_order { string po_id PK
    string po_user_id
    decimal po_value }
  po_line_item { string po_id PK
    string line_number PK
    int quantity
    int quantity_shipped }
  order_manager { string order_id PK
    string status }
  supplier_order { string po_id PK
    string po_status }
  inventory { string item_id PK
    int quantity }
  counter { string name PK
    int counter }
