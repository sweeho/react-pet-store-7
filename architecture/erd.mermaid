erDiagram
  category ||--o{ category_details : "per locale"
  category ||--o{ product : contains
  product ||--o{ product_details : "per locale"
  product ||--o{ item : contains
  item ||--o{ item_details : "per locale"
  signon_user ||--|| customer : "user_id"
  customer }o--|| account : has
  customer }o--|| profile : has
  account }o--|| contact_info : contact
  account }o--|| credit_card : card
  contact_info }o--|| address : address
  purchase_order }o--|| contact_info : contact
  purchase_order }o--|| credit_card : card
  purchase_order ||--o{ po_line_item : lines
